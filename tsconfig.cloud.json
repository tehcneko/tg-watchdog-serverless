{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.cloud.tsbuildinfo",
    "target": "es2025",
    "lib": ["ESNext"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "esnext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "sdk": ["./cloud/types/sdk/index.d.ts"],
      "sdk/db": ["./cloud/types/sdk/db.d.ts"],
      "lib/*": ["./cloud/lib/*"],
      "schema": ["./cloud/schema.ts"]
    }
  },
  "include": ["cloud/**/*.ts"]
}
