{
  "name": "tg-watchdog-serverless",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-s build:*",
    "build:cloud": "tsc -p tsconfig.cloud.json --noEmit && tsdown -c tsdown.cloud.config.mts",
    "build:web": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && tgcloud push",
    "migrate": "tgcloud migrate",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write src/ cloud/"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@vueuse/core": "^15.0.0",
    "cfturnstile-vue3": "^2.0.0",
    "i18n-js": "^4.5.4",
    "petite-vue-i18n": "^11.4.13",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@grammyjs/types": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tgcloud/cli": "^0.2.0",
    "@types/node": "^24.19.1",
    "@types/telegram-web-app": "^10.1.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-oxlint": "^1.87.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "npm:typescript-native-bridge@^6.0.3-bridge.18.tsgo.7.0.2",
    "vite": "^8.3.3",
    "vue-tsc": "^3.3.12"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
